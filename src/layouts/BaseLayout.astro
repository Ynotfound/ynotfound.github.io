---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ExcaliburCursor from '../components/ExcaliburCursor.astro';
interface Props { title: string; description?: string; active?: string; locale?: 'zh' | 'en'; }
const { title, description = 'Yu Zhehao — Physics, Mathematics and AI.', active = '', locale = 'zh' } = Astro.props;
const canonical = 'https://ynotfound.github.io' + Astro.url.pathname;
const zhPath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const enPath = '/en' + (zhPath === '/' ? '/' : zhPath);
const alternateZh = 'https://ynotfound.github.io' + zhPath;
const alternateEn = 'https://ynotfound.github.io' + enPath;
const languageTarget = locale === 'en' ? zhPath : enPath;
---
<!doctype html>
<html lang={locale === 'en' ? 'en' : 'zh-CN'} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f3ed" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={alternateZh} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateZh} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Yu Zhehao</title>
    <script is:inline>
      try {
        const theme = localStorage.getItem('yz-theme');
        if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme;
        else if (window.matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.dataset.theme = 'dark';
      } catch (_) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{locale === 'en' ? 'Skip to content' : '跳转到正文'}</a>
    <SiteHeader active={active} locale={locale} languageTarget={languageTarget} />
    <main id="main-content"><slot /></main>
    <SiteFooter locale={locale} />
    <ExcaliburCursor />
    <script>
  // @ts-nocheck -- imperative DOM/Canvas runtime; content schemas and routes remain type-checked.
      const root = document.documentElement;
      const themeButton = document.querySelector('[data-theme-toggle]');
      const langButton = document.querySelector('[data-lang-toggle]');
      const menuButton = document.querySelector('[data-menu-toggle]');
      const nav = document.querySelector('[data-primary-nav]');
      function applyTheme(theme) {
        root.dataset.theme = theme;
        if (themeButton) {
          themeButton.textContent = theme === 'dark' ? '☼' : '☾';
          themeButton.setAttribute('aria-label', theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
        }
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.content = theme === 'dark' ? '#081521' : '#f5f3ed';
        try { localStorage.setItem('yz-theme', theme); } catch (_) {}
      }
      function setMenu(open) {
        if (!nav || !menuButton) return;
        nav.classList.toggle('is-open', open);
        menuButton.setAttribute('aria-expanded', String(open));
        menuButton.textContent = open ? '×' : '☰';
      }
      applyTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');
      themeButton?.addEventListener('click', () => applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark'));
      langButton?.addEventListener('click', () => {
        const target = langButton.getAttribute('data-target');
        if (target) window.location.assign(target);
      });
      menuButton?.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
      document.addEventListener('click', (event) => {
        if (nav && menuButton && !nav.contains(event.target) && !menuButton.contains(event.target)) setMenu(false);
      });
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setMenu(false); });
    </script>
  </body>
</html>
