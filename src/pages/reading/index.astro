---
import { getCollection } from 'astro:content';
import CollectionIndex from '../../components/CollectionIndex.astro';
const entries = (await getCollection('references', ({ data }) => !data.draft && data.lang === 'zh'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<CollectionIndex title="阅读与参考资料" description="研究中实际使用的文献、软件说明和支持性材料入口。优先保存可追溯的原始来源，而不是堆砌书单。" kicker="READING / REFERENCES" active="reading" basePath="/reading/" entries={entries} locale="zh" />
