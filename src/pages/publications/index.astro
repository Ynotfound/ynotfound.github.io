---
import { getCollection } from 'astro:content';
import CollectionIndex from '../../components/CollectionIndex.astro';
const entries = (await getCollection('publications', ({ data }) => !data.draft && data.lang === 'zh'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<CollectionIndex title="论文与研究手稿" description="严格区分正式发表、公开预印本与工作手稿。每项成果都有独立记录、版本状态和原始文件入口。" kicker="PUBLICATIONS / 论文档案" active="publications" basePath="/publications/" entries={entries} locale="zh" variant="list" />
