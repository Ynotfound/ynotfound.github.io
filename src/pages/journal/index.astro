---
import { getCollection } from 'astro:content';
import CollectionIndex from '../../components/CollectionIndex.astro';
const entries = (await getCollection('journal', ({ data }) => !data.draft && data.lang === 'zh'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<CollectionIndex title="研究随笔" description="记录论文阅读、研究思考、计算实验和学习过程。随笔可以保留问题与失败，但会明确标明它们的状态。" kicker="FIELD NOTES / JOURNAL" active="journal" basePath="/journal/" entries={entries} locale="zh" variant="list" emptyTitle="公开随笔档案正在建立" emptyDescription="在 src/content/journal/ 中添加一对中英文 Markdown 文件，推送后便会自动生成独立文章页。" />
