---
import { getCollection } from 'astro:content';
import CollectionIndex from '../../components/CollectionIndex.astro';
const entries = (await getCollection('projects', ({ data }) => !data.draft && data.lang === 'zh'))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.getTime() - a.data.date.getTime());
---
<CollectionIndex title="项目与代码" description="研究软件、AI 实验与个人技术原型。项目状态、构建方式和贡献记录以各自仓库为准。" kicker="PROJECTS / CODE" active="projects" basePath="/projects/" entries={entries} locale="zh" />
