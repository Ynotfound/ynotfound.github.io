---
import { getCollection, render } from 'astro:content';
import CollectionDetail from '../../components/CollectionDetail.astro';
export async function getStaticPaths() {
  const entries = await getCollection('research', ({ data }) => !data.draft && data.lang === 'zh');
  return Promise.all(entries.map(async (entry) => ({ params: { slug: entry.data.translationKey }, props: { entry } })));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const updates = (await getCollection('researchUpdates', ({ data }) => !data.draft && data.lang === 'zh' && data.projectKey === entry.data.translationKey))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<CollectionDetail entry={entry} Content={Content} headings={headings} updates={updates} active="research" basePath="/research/" sectionLabel="研究" locale="zh" />
