---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchTimeline from '../../components/ResearchTimeline.astro';
const programmes = (await getCollection('research', ({ data }) => !data.draft && data.lang === 'zh'))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title, 'zh-CN'));
const updates = (await getCollection('researchUpdates', ({ data }) => !data.draft && data.lang === 'zh'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const activeCount = programmes.filter((entry) => entry.data.status === 'active').length;
const exploratoryCount = programmes.filter((entry) => entry.data.status === 'exploratory').length;
const projectNames = Object.fromEntries(programmes.map((entry) => [entry.data.translationKey, entry.data.title]));
const statusLabels: Record<string, string> = { active: '进行中', exploratory: '探索阶段', paused: '暂停', completed: '已完成' };
const statusDescriptions: Record<string, string> = {
  active: '正在持续推进的研究主线', exploratory: '仍处于结构探索与可行性研究阶段',
  paused: '暂时搁置，等待后续条件', completed: '已完成当前设定目标'
};
---
<BaseLayout title="Research Observatory" active="research" description="A structured observatory of research programmes, evidence states and dated research records by Yu Zhehao.">
  <div class="page-shell">
    <div class="breadcrumbs"><a href="/">首页</a><span>/</span><a href="/research/">研究</a><span>/</span>研究观测站</div>
    <header class="page-heading">
      <p class="page-kicker">RESEARCH OBSERVATORY / 研究观测站</p>
      <h1 class="page-title">研究主线与进展</h1>
      <p class="page-lead">把研究方向、阶段记录与证据状态放在同一处。这里记录研究实际走到了哪里，而不把计划、数值吻合或未完成的推导包装成已证明结果。</p>
    </header>
    <section class="research-stats" aria-label="Research overview">
      <div class="research-stat"><span>ACTIVE PROGRAMMES</span><strong>{activeCount.toString().padStart(2, '0')}</strong><small>持续推进的研究主线</small></div>
      <div class="research-stat"><span>EXPLORATORY</span><strong>{exploratoryCount.toString().padStart(2, '0')}</strong><small>仍在探索的研究方向</small></div>
      <div class="research-stat"><span>PUBLIC RECORDS</span><strong>{updates.length.toString().padStart(2, '0')}</strong><small>公开研究记录，含状态快照</small></div>
    </section>
    <section class="section-block">
      <div class="section-heading">
        <div><p class="page-kicker">PROGRAMMES / 研究计划</p><h2>研究主线</h2></div>
        <a class="text-link" href="/research/">全部研究方向 ↗</a>
      </div>
      <div class="programme-grid">
        {programmes.map((entry) => {
          const related = updates.filter((update) => update.data.projectKey === entry.data.translationKey);
          const latestUpdate = related[0];
          return (
            <a class="programme-card" href={'/research/' + entry.data.translationKey + '/'}>
              <div class="programme-card-top">
                <span class="programme-category">{entry.data.category}</span>
                <span class:list={['programme-status', 'programme-' + entry.data.status]}>{statusLabels[entry.data.status] ?? entry.data.status}</span>
              </div>
              <h3>{entry.data.title}</h3><p>{entry.data.description}</p>
              <div class="programme-card-bottom">
                <span>{related.length} 条记录</span>
                <span>{latestUpdate ? '最近记录 ' + latestUpdate.data.date.toLocaleDateString('zh-CN', { month: 'short', day: 'numeric', timeZone: 'UTC' }) : '尚无进展记录'}</span>
              </div>
              <span class="programme-status-description">{statusDescriptions[entry.data.status]}</span>
            </a>
          );
        })}
      </div>
    </section>
    <ResearchTimeline entries={updates.slice(0, 12)} projectNames={projectNames} locale="zh" />
    <section class="section-block evidence-panel">
      <p class="page-kicker">EVIDENCE POLICY / 证据规范</p>
      <h2>不同证据，不混为一谈。</h2>
      <div class="evidence-grid">
        <div><strong>证明</strong><p>有完整定义、假设与推导的数学论证。</p></div>
        <div><strong>符号验证</strong><p>由独立符号计算或恒等式检查支持，仍需明确适用范围。</p></div>
        <div><strong>数值验证</strong><p>仅覆盖明确测试范围，不自动推出一般结论。</p></div>
        <div><strong>研究快照</strong><p>记录当前目标与工作状态，本身不代表取得新定理。</p></div>
      </div>
    </section>
  </div>
</BaseLayout>
