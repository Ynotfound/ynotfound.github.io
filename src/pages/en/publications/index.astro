---
import { getCollection } from 'astro:content';
import CollectionIndex from '../../../components/CollectionIndex.astro';
const entries = (await getCollection('publications', ({ data }) => !data.draft && data.lang === 'en'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<CollectionIndex title="Publications & manuscripts" description="Published papers, public preprints and working manuscripts are distinguished explicitly. Each record has its own status and source links." kicker="PUBLICATIONS / PAPERS" active="publications" basePath="/en/publications/" entries={entries} locale="en" variant="list" />
