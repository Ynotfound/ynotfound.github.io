---
import { getCollection } from 'astro:content';
import CollectionIndex from '../../../components/CollectionIndex.astro';
const entries = (await getCollection('journal', ({ data }) => !data.draft && data.lang === 'en'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<CollectionIndex title="Research journal" description="Paper reflections, research ideas, computational experiments and learning notes. Open questions and failed attempts are welcome when their status is made explicit." kicker="FIELD NOTES / JOURNAL" active="journal" basePath="/en/journal/" entries={entries} locale="en" variant="list" emptyTitle="The public journal is taking shape" emptyDescription="Add a paired Chinese and English Markdown entry under src/content/journal/; the site will generate its article pages automatically." />
