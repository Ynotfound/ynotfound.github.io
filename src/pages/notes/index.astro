---
import { getCollection } from 'astro:content';
import CollectionIndex from '../../components/CollectionIndex.astro';
const entries = (await getCollection('notes', ({ data }) => !data.draft && data.lang === 'zh'))
  .sort((a, b) => a.data.order - b.data.order || b.data.date.getTime() - a.data.date.getTime());
---
<CollectionIndex title="笔记与知识库" description="数学、物理与 AI 的长期笔记。每篇文章都有独立链接，支持 LaTeX 数学公式、代码高亮和目录。" kicker="KNOWLEDGE ARCHIVE / 知识库" active="notes" basePath="/notes/" entries={entries} locale="zh" variant="list" />
