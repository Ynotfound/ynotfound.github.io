<canvas class="sword-trail" data-sword-trail aria-hidden="true"></canvas>
<script>
  (() => {
    // The sword itself is the browser-native CSS cursor (public/cursor.svg).
    // This canvas is only the decorative trail; it can never hide the pointer.
    const finePointer = window.matchMedia('(any-hover: hover) and (any-pointer: fine)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!finePointer.matches) return;

    document.documentElement.classList.add('has-sword-cursor');
    if (reducedMotion.matches) return;

    const canvas = document.querySelector('[data-sword-trail]');
    const context = canvas instanceof HTMLCanvasElement ? canvas.getContext('2d') : null;
    if (!(canvas instanceof HTMLCanvasElement) || !context) return;

    const nodes = Array.from({ length: 14 }, () => ({ x: 0, y: 0 }));
    const sparks = [];
    const pointer = { x: 0, y: 0, active: false, hovering: false };
    let width = innerWidth, height = innerHeight, dpr = 1, frame = 0, previous = 0;

    const random = (min, max) => min + Math.random() * (max - min);
    const clamp = (value, min, max) => Math.max(min, Math.min(max, value));

    function resize() {
      width = innerWidth;
      height = innerHeight;
      dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      context.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function emit(x, y, vx, vy, intensity = 1) {
      sparks.push({
        x, y,
        vx: vx * -.055 + random(-25, 25) * intensity,
        vy: vy * -.055 + random(-25, 25) * intensity,
        life: random(.25, .55),
        max: .55,
        size: random(.7, 1.65) * intensity,
        blue: Math.random() > .58
      });
      if (sparks.length > 54) sparks.splice(0, sparks.length - 54);
    }

    function start() {
      if (!frame) frame = requestAnimationFrame(tick);
    }

    function move(event) {
      if (event.pointerType === 'touch') return;
      const now = performance.now();
      const dx = pointer.active ? event.clientX - pointer.x : 0;
      const dy = pointer.active ? event.clientY - pointer.y : 0;
      const dt = previous ? Math.max((now - previous) / 1000, .008) : .016;
      pointer.x = event.clientX;
      pointer.y = event.clientY;

      if (!pointer.active) {
        nodes.forEach((node) => { node.x = pointer.x; node.y = pointer.y; });
        pointer.active = true;
      } else {
        nodes[0].x = pointer.x;
        nodes[0].y = pointer.y;
        const speed = Math.hypot(dx, dy);
        if (speed > 3) {
          const count = Math.min(4, Math.max(1, Math.floor(speed / 24)));
          for (let i = 0; i < count; i++) {
            const t = (i + 1) / (count + 1);
            emit(pointer.x - dx * (1 - t), pointer.y - dy * (1 - t), dx / dt, dy / dt, clamp(speed / 34, .5, 1.2));
          }
        }
      }
      previous = now;
      start();
    }

    function paint(dt) {
      context.clearRect(0, 0, width, height);
      if (pointer.active) {
        context.save();
        context.globalCompositeOperation = 'lighter';
        const head = nodes[0], tail = nodes[nodes.length - 1];
        const gradient = context.createLinearGradient(head.x, head.y, tail.x, tail.y);
        gradient.addColorStop(0, 'rgba(255,244,211,.62)');
        gradient.addColorStop(.38, 'rgba(222,190,124,.32)');
        gradient.addColorStop(1, 'rgba(135,184,215,0)');
        context.beginPath();
        context.moveTo(head.x, head.y);
        for (let i = 1; i < nodes.length - 1; i++) {
          const mx = (nodes[i].x + nodes[i + 1].x) / 2;
          const my = (nodes[i].y + nodes[i + 1].y) / 2;
          context.quadraticCurveTo(nodes[i].x, nodes[i].y, mx, my);
        }
        context.lineTo(tail.x, tail.y);
        context.strokeStyle = gradient;
        context.lineWidth = pointer.hovering ? 1.8 : 1.35;
        context.lineCap = 'round';
        context.shadowBlur = 8;
        context.shadowColor = 'rgba(220,190,126,.4)';
        context.stroke();
        context.restore();
      }

      context.save();
      context.globalCompositeOperation = 'lighter';
      for (let i = sparks.length - 1; i >= 0; i--) {
        const spark = sparks[i];
        spark.life -= dt;
        if (spark.life <= 0) { sparks.splice(i, 1); continue; }
        spark.x += spark.vx * dt;
        spark.y += spark.vy * dt;
        spark.vx *= .984;
        spark.vy *= .984;
        const alpha = Math.max(0, spark.life / spark.max);
        const rgb = spark.blue ? '169,211,239' : '255,224,163';
        const glow = context.createRadialGradient(spark.x, spark.y, 0, spark.x, spark.y, spark.size * 4.5);
        glow.addColorStop(0, 'rgba(' + rgb + ',' + (alpha * .72) + ')');
        glow.addColorStop(1, 'rgba(' + rgb + ',0)');
        context.fillStyle = glow;
        context.beginPath();
        context.arc(spark.x, spark.y, spark.size * 4.5, 0, Math.PI * 2);
        context.fill();
      }
      context.restore();
    }

    function tick(stamp) {
      frame = 0;
      const dt = previous ? Math.min((stamp - previous) / 1000, .04) : .016;
      previous = stamp;
      let moving = false;
      for (let i = 1; i < nodes.length; i++) {
        const node = nodes[i], prior = nodes[i - 1];
        const follow = Math.max(.14, .38 - i * .017);
        const dx = (prior.x - node.x) * follow;
        const dy = (prior.y - node.y) * follow;
        node.x += dx;
        node.y += dy;
        if (Math.abs(dx) + Math.abs(dy) > .1) moving = true;
      }
      paint(dt);
      if (moving || sparks.length) frame = requestAnimationFrame(tick);
      else previous = 0;
    }

    document.addEventListener('pointermove', move, { passive: true });
    document.addEventListener('pointerover', (event) => {
      pointer.hovering = event.target instanceof Element &&
        !!event.target.closest('a,button,[role="button"],input,textarea,select,label');
    }, true);
    document.addEventListener('pointerout', (event) => {
      const from = event.target instanceof Element && event.target.closest('a,button,[role="button"],input,textarea,select,label');
      const to = event.relatedTarget instanceof Element && event.relatedTarget.closest('a,button,[role="button"],input,textarea,select,label');
      if (from && !to) pointer.hovering = false;
    }, true);
    document.addEventListener('pointerdown', () => {
      if (!pointer.active) return;
      for (let i = 0; i < 7; i++) {
        const angle = Math.PI * 2 * i / 7;
        emit(pointer.x, pointer.y, Math.cos(angle) * 48, Math.sin(angle) * 48, .85);
      }
      start();
    }, true);
    window.addEventListener('resize', resize, { passive: true });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { cancelAnimationFrame(frame); frame = 0; previous = 0; }
    });
    resize();
  })();
</script>
