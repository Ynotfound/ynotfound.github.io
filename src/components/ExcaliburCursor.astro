<canvas class="sword-trail" data-sword-trail aria-hidden="true"></canvas>
<div class="sword-cursor" data-sword-cursor aria-hidden="true">
  <svg viewBox="0 0 80 160">
    <defs>
      <linearGradient id="cursorBlade" x1="25" y1="4" x2="55" y2="90" gradientUnits="userSpaceOnUse">
        <stop stop-color="#fff8e4"/><stop offset=".34" stop-color="#e6cb8c"/><stop offset="1" stop-color="#9d7c49"/>
      </linearGradient>
      <linearGradient id="cursorGuard" x1="8" y1="78" x2="72" y2="98" gradientUnits="userSpaceOnUse">
        <stop stop-color="#947443"/><stop offset=".5" stop-color="#f2dfad"/><stop offset="1" stop-color="#9a7948"/>
      </linearGradient>
    </defs>
    <path d="M40 3L53 61L48 86H32L27 61Z" fill="url(#cursorBlade)"/>
    <path d="M40 7L44 61L40 80L36 61Z" fill="#fff" fill-opacity=".42"/>
    <path d="M8 78Q20 84 34 79L40 84L46 79Q60 84 72 78L67 89Q54 98 42 89L40 87L38 89Q26 98 13 89Z" fill="url(#cursorGuard)" stroke="#8f7141" stroke-width="1"/>
    <path d="M35 89H45L44 130H36Z" fill="#17334a" stroke="#d9bd7d" stroke-width="1.2"/>
    <path d="M35.5 98L44.5 104M35.5 108L44.5 114M35.5 118L44.5 124" stroke="#d9bd7d" stroke-width="1.1"/>
    <path d="M34 129Q40 125 46 129L49 139L40 149L31 139Z" fill="url(#cursorGuard)" stroke="#8f7141" stroke-width=".8"/>
    <path d="M40 132L44 138L40 144L36 138Z" fill="#9fc6dc" stroke="#f3dfad" stroke-width="1"/>
  </svg>
</div>
<script>
  (() => {
    // Detect any connected mouse/pen, not only the device's primary pointer.
    const finePointer = window.matchMedia('(any-hover: hover) and (any-pointer: fine)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const cursor = document.querySelector('[data-sword-cursor]');
    const canvas = document.querySelector('[data-sword-trail]');

    // The sword cursor must work even when canvas effects are unavailable or reduced.
    if (!finePointer.matches || !(cursor instanceof HTMLElement)) return;
    document.documentElement.classList.add('has-sword-cursor');

    let context = null;
    if (canvas instanceof HTMLCanvasElement) {
      try { context = canvas.getContext('2d'); } catch (_) { context = null; }
    }
    const trailEnabled = !!context && !reducedMotion.matches;
    const state = {
      x: 0, y: 0, lastX: 0, lastY: 0, lastTime: 0,
      visible: false, hovering: false
    };
    const nodes = trailEnabled
      ? Array.from({ length: 14 }, () => ({ x: 0, y: 0 }))
      : [];
    const sparks = [];
    let width = innerWidth, height = innerHeight, dpr = 1, frame = 0, previous = 0;

    const random = (min, max) => min + Math.random() * (max - min);
    const clamp = (value, min, max) => Math.max(min, Math.min(max, value));

    function resize() {
      width = innerWidth;
      height = innerHeight;
      if (!context || !(canvas instanceof HTMLCanvasElement)) return;
      dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      context.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function emit(x, y, vx, vy, intensity = 1) {
      if (!trailEnabled) return;
      sparks.push({
        x, y,
        vx: vx * -.07 + random(-34, 34) * intensity,
        vy: vy * -.07 + random(-34, 34) * intensity,
        life: random(.34, .72),
        max: .72,
        size: random(.8, 2.1) * intensity,
        blue: Math.random() > .58
      });
      if (sparks.length > 60) sparks.splice(0, sparks.length - 60);
    }

    function start() {
      if (trailEnabled && !frame) frame = requestAnimationFrame(tick);
    }

    function move(event) {
      if (event.pointerType === 'touch') return;
      const now = performance.now();
      const firstMove = !state.visible;
      const dx = firstMove ? 0 : event.clientX - state.lastX;
      const dy = firstMove ? 0 : event.clientY - state.lastY;
      const dt = state.lastTime ? Math.max((now - state.lastTime) / 1000, .008) : .016;

      state.x = event.clientX;
      state.y = event.clientY;
      state.visible = true;

      // Direct positioning keeps the sword tip locked to the actual pointer hotspot.
      cursor.style.transform = 'translate3d(' + state.x.toFixed(2) + 'px,' + state.y.toFixed(2) + 'px,0)';
      cursor.classList.add('is-visible');

      if (trailEnabled) {
        if (firstMove) {
          nodes.forEach((node) => { node.x = state.x; node.y = state.y; });
        } else if (nodes.length) {
          nodes[0].x = state.x;
          nodes[0].y = state.y;
        }
        const speed = Math.hypot(dx, dy);
        if (!firstMove && speed > 3) {
          const count = Math.min(4, Math.max(1, Math.floor(speed / 20)));
          for (let i = 0; i < count; i++) {
            const t = (i + 1) / (count + 1);
            emit(state.lastX + dx * t, state.lastY + dy * t, dx / dt, dy / dt, clamp(speed / 30, .55, 1.35));
          }
        }
        start();
      }

      state.lastX = state.x;
      state.lastY = state.y;
      state.lastTime = now;
    }

    function paint(dt) {
      if (!context) return;
      context.clearRect(0, 0, width, height);

      if (state.visible && nodes.length) {
        context.save();
        context.globalCompositeOperation = 'lighter';
        const first = nodes[0], last = nodes[nodes.length - 1];
        const gradient = context.createLinearGradient(first.x, first.y, last.x, last.y);
        gradient.addColorStop(0, 'rgba(255,244,211,.7)');
        gradient.addColorStop(.35, 'rgba(222,190,124,.38)');
        gradient.addColorStop(1, 'rgba(135,184,215,0)');
        context.beginPath();
        context.moveTo(first.x, first.y);
        for (let i = 1; i < nodes.length - 1; i++) {
          const mx = (nodes[i].x + nodes[i + 1].x) / 2;
          const my = (nodes[i].y + nodes[i + 1].y) / 2;
          context.quadraticCurveTo(nodes[i].x, nodes[i].y, mx, my);
        }
        context.lineTo(last.x, last.y);
        context.strokeStyle = gradient;
        context.lineWidth = state.hovering ? 2.1 : 1.55;
        context.lineCap = 'round';
        context.shadowBlur = 10;
        context.shadowColor = 'rgba(220,190,126,.55)';
        context.stroke();
        context.restore();
      }

      context.save();
      context.globalCompositeOperation = 'lighter';
      for (let i = sparks.length - 1; i >= 0; i--) {
        const spark = sparks[i];
        spark.life -= dt;
        if (spark.life <= 0) { sparks.splice(i, 1); continue; }
        spark.x += spark.vx * dt;
        spark.y += spark.vy * dt;
        spark.vx *= .982;
        spark.vy *= .982;
        const alpha = Math.max(0, spark.life / spark.max);
        const rgb = spark.blue ? '169,211,239' : '255,224,163';
        const glow = context.createRadialGradient(spark.x, spark.y, 0, spark.x, spark.y, spark.size * 5);
        glow.addColorStop(0, 'rgba(' + rgb + ',' + (alpha * .8) + ')');
        glow.addColorStop(1, 'rgba(' + rgb + ',0)');
        context.fillStyle = glow;
        context.beginPath();
        context.arc(spark.x, spark.y, spark.size * 5, 0, Math.PI * 2);
        context.fill();
      }
      context.restore();
    }

    function tick(stamp) {
      frame = 0;
      const dt = previous ? Math.min((stamp - previous) / 1000, .04) : .016;
      previous = stamp;

      let unsettled = false;
      if (nodes.length) {
        nodes[0].x = state.x;
        nodes[0].y = state.y;
        for (let i = 1; i < nodes.length; i++) {
          const point = nodes[i], prior = nodes[i - 1];
          const follow = Math.max(.16, .42 - i * .021);
          const dx = (prior.x - point.x) * follow;
          const dy = (prior.y - point.y) * follow;
          point.x += dx;
          point.y += dy;
          if (Math.abs(dx) + Math.abs(dy) > .12) unsettled = true;
        }
      }

      paint(dt);
      if (unsettled || sparks.length) frame = requestAnimationFrame(tick);
      else previous = 0;
    }

    function hide() {
      state.visible = false;
      cursor.classList.remove('is-visible');
      if (sparks.length) start();
    }

    document.addEventListener('pointermove', move, { passive: true });
    document.addEventListener('pointerover', (event) => {
      if (event.target instanceof Element && event.target.closest('a,button,[role="button"],input,textarea,select,label')) {
        state.hovering = true;
        cursor.classList.add('is-hovering');
      }
    }, true);
    document.addEventListener('pointerout', (event) => {
      const from = event.target instanceof Element && event.target.closest('a,button,[role="button"],input,textarea,select,label');
      const to = event.relatedTarget instanceof Element && event.relatedTarget.closest('a,button,[role="button"],input,textarea,select,label');
      if (from && !to) {
        state.hovering = false;
        cursor.classList.remove('is-hovering');
      }
    }, true);
    document.addEventListener('pointerdown', () => {
      cursor.classList.add('is-pressed');
      if (state.visible && trailEnabled) {
        for (let i = 0; i < 8; i++) {
          const angle = Math.PI * 2 * i / 8;
          emit(state.x, state.y, Math.cos(angle) * 65, Math.sin(angle) * 65, 1);
        }
        start();
      }
    }, true);
    document.addEventListener('pointerup', () => cursor.classList.remove('is-pressed'), true);
    window.addEventListener('pointerout', (event) => { if (!event.relatedTarget) hide(); });
    window.addEventListener('blur', hide);
    window.addEventListener('resize', resize, { passive: true });
    document.addEventListener('visibilitychange', () => { if (document.hidden) hide(); });
    resize();
  })();
</script>
