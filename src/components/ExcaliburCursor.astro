<canvas class="sword-trail" data-sword-trail aria-hidden="true"></canvas>
<div class="sword-cursor" data-sword-cursor aria-hidden="true">
  <svg viewBox="0 0 80 160">
    <defs>
      <linearGradient id="cursorBlade" x1="25" y1="4" x2="55" y2="90" gradientUnits="userSpaceOnUse"><stop stop-color="#fff8e4"/><stop offset=".34" stop-color="#e6cb8c"/><stop offset="1" stop-color="#9d7c49"/></linearGradient>
      <linearGradient id="cursorGuard" x1="8" y1="78" x2="72" y2="98" gradientUnits="userSpaceOnUse"><stop stop-color="#947443"/><stop offset=".5" stop-color="#f2dfad"/><stop offset="1" stop-color="#9a7948"/></linearGradient>
    </defs>
    <path d="M40 3L53 61L48 86H32L27 61Z" fill="url(#cursorBlade)"/>
    <path d="M40 7L44 61L40 80L36 61Z" fill="#fff" fill-opacity=".42"/>
    <path d="M8 78Q20 84 34 79L40 84L46 79Q60 84 72 78L67 89Q54 98 42 89L40 87L38 89Q26 98 13 89Z" fill="url(#cursorGuard)" stroke="#8f7141" stroke-width="1"/>
    <path d="M35 89H45L44 130H36Z" fill="#17334a" stroke="#d9bd7d" stroke-width="1.2"/>
    <path d="M35.5 98L44.5 104M35.5 108L44.5 114M35.5 118L44.5 124" stroke="#d9bd7d" stroke-width="1.1"/>
    <path d="M34 129Q40 125 46 129L49 139L40 149L31 139Z" fill="url(#cursorGuard)" stroke="#8f7141" stroke-width=".8"/>
    <path d="M40 132L44 138L40 144L36 138Z" fill="#9fc6dc" stroke="#f3dfad" stroke-width="1"/>
  </svg>
</div>
<script>
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const cursor = document.querySelector('[data-sword-cursor]');
  const canvas = document.querySelector('[data-sword-trail]');
  const context = canvas instanceof HTMLCanvasElement ? canvas.getContext('2d') : null;
  if (finePointer.matches && cursor instanceof HTMLElement && canvas instanceof HTMLCanvasElement && context) {
    document.documentElement.classList.add('has-sword-cursor');
    const state = { x: innerWidth / 2, y: innerHeight / 2, tx: innerWidth / 2, ty: innerHeight / 2, visible: false, hovering: false, lastX: innerWidth / 2, lastY: innerHeight / 2, lastTime: 0 };
    const nodes = Array.from({ length: 12 }, () => ({ x: state.x, y: state.y }));
    const sparks = [];
    let width = innerWidth, height = innerHeight, dpr = 1, frame = 0, previous = 0;
    const random = (a, b) => a + Math.random() * (b - a);
    const clamp = (x, a, b) => Math.max(a, Math.min(b, x));
    function resize() {
      width = innerWidth; height = innerHeight; dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * dpr); canvas.height = Math.round(height * dpr);
      context.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    function emit(x, y, vx, vy, intensity = 1) {
      sparks.push({ x, y, vx: vx * -.07 + random(-34, 34) * intensity, vy: vy * -.07 + random(-34, 34) * intensity, life: random(.34, .72), max: .72, size: random(.8, 2.1) * intensity, blue: Math.random() > .58 });
      if (sparks.length > 60) sparks.splice(0, sparks.length - 60);
    }
    function move(event) {
      if (event.pointerType === 'touch') return;
      const now = performance.now(), dx = event.clientX - state.lastX, dy = event.clientY - state.lastY;
      const dt = state.lastTime ? Math.max((now - state.lastTime) / 1000, .008) : .016;
      state.tx = event.clientX; state.ty = event.clientY; state.visible = true; cursor.classList.add('is-visible');
      const speed = Math.hypot(dx, dy);
      if (!reducedMotion.matches && speed > 3) {
        const count = Math.min(4, Math.max(1, Math.floor(speed / 20)));
        for (let i = 0; i < count; i++) { const t = (i + 1) / (count + 1); emit(state.lastX + dx * t, state.lastY + dy * t, dx / dt, dy / dt, clamp(speed / 30, .55, 1.35)); }
      }
      state.lastX = event.clientX; state.lastY = event.clientY; state.lastTime = now; start();
    }
    function paint(dt) {
      context.clearRect(0, 0, width, height);
      if (reducedMotion.matches) return;
      if (state.visible) {
        context.save(); context.globalCompositeOperation = 'lighter';
        const first = nodes[0], last = nodes[nodes.length - 1], gradient = context.createLinearGradient(first.x, first.y, last.x, last.y);
        gradient.addColorStop(0, 'rgba(255,244,211,.7)'); gradient.addColorStop(.35, 'rgba(222,190,124,.38)'); gradient.addColorStop(1, 'rgba(135,184,215,0)');
        context.beginPath(); context.moveTo(first.x, first.y);
        for (let i = 1; i < nodes.length - 1; i++) { const mx = (nodes[i].x + nodes[i + 1].x) / 2, my = (nodes[i].y + nodes[i + 1].y) / 2; context.quadraticCurveTo(nodes[i].x, nodes[i].y, mx, my); }
        context.lineTo(last.x, last.y); context.strokeStyle = gradient; context.lineWidth = state.hovering ? 2.1 : 1.55; context.lineCap = 'round'; context.shadowBlur = 10; context.shadowColor = 'rgba(220,190,126,.55)'; context.stroke(); context.restore();
      }
      context.save(); context.globalCompositeOperation = 'lighter';
      for (let i = sparks.length - 1; i >= 0; i--) {
        const p = sparks[i]; p.life -= dt; if (p.life <= 0) { sparks.splice(i, 1); continue; }
        p.x += p.vx * dt; p.y += p.vy * dt; p.vx *= .982; p.vy *= .982;
        const alpha = Math.max(0, p.life / p.max), rgb = p.blue ? '169,211,239' : '255,224,163';
        const glow = context.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.size * 5);
        glow.addColorStop(0, 'rgba(' + rgb + ',' + (alpha * .8) + ')'); glow.addColorStop(1, 'rgba(' + rgb + ',0)');
        context.fillStyle = glow; context.beginPath(); context.arc(p.x, p.y, p.size * 5, 0, Math.PI * 2); context.fill();
      }
      context.restore();
    }
    function tick(stamp) {
      frame = 0; const dt = previous ? Math.min((stamp - previous) / 1000, .04) : .016; previous = stamp;
      state.x += (state.tx - state.x) * .82; state.y += (state.ty - state.y) * .82;
      cursor.style.transform = 'translate3d(' + state.x.toFixed(2) + 'px,' + state.y.toFixed(2) + 'px,0)';
      nodes[0].x = state.x; nodes[0].y = state.y;
      let unsettled = Math.hypot(state.tx - state.x, state.ty - state.y) > .15;
      for (let i = 1; i < nodes.length; i++) {
        const p = nodes[i], prev = nodes[i - 1], follow = Math.max(.16, .42 - i * .021);
        const dx = (prev.x - p.x) * follow, dy = (prev.y - p.y) * follow; p.x += dx; p.y += dy;
        if (Math.abs(dx) + Math.abs(dy) > .12) unsettled = true;
      }
      paint(dt); if (unsettled || sparks.length) frame = requestAnimationFrame(tick); else previous = 0;
    }
    function start() { if (!frame) frame = requestAnimationFrame(tick); }
    function hide() { state.visible = false; cursor.classList.remove('is-visible'); if (sparks.length) start(); }
    document.addEventListener('pointermove', move, { passive: true });
    document.addEventListener('pointerover', (event) => { if (event.target instanceof Element && event.target.closest('a,button,[role="button"],input,textarea,select,label')) { state.hovering = true; cursor.classList.add('is-hovering'); } }, true);
    document.addEventListener('pointerout', (event) => {
      const from = event.target instanceof Element && event.target.closest('a,button,[role="button"],input,textarea,select,label');
      const to = event.relatedTarget instanceof Element && event.relatedTarget.closest('a,button,[role="button"],input,textarea,select,label');
      if (from && !to) { state.hovering = false; cursor.classList.remove('is-hovering'); }
    }, true);
    document.addEventListener('pointerdown', () => {
      cursor.classList.add('is-pressed');
      if (!reducedMotion.matches && state.visible) { for (let i = 0; i < 8; i++) { const a = Math.PI * 2 * i / 8; emit(state.x, state.y, Math.cos(a) * 65, Math.sin(a) * 65, 1); } start(); }
    }, true);
    document.addEventListener('pointerup', () => cursor.classList.remove('is-pressed'), true);
    window.addEventListener('pointerout', (event) => { if (!event.relatedTarget) hide(); });
    window.addEventListener('blur', hide); window.addEventListener('resize', resize, { passive: true });
    document.addEventListener('visibilitychange', () => { if (document.hidden) hide(); });
    resize();
  }
</script>
