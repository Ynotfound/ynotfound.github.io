<div class="orbital-field" data-orbital-field aria-label="Interactive animated orbital field">
  <canvas data-orbital-canvas aria-hidden="true"></canvas>
  <div class="orbital-core" aria-hidden="true">
    <svg viewBox="0 0 80 180">
      <defs><linearGradient id="coreBlade" x1="25" y1="5" x2="55" y2="145" gradientUnits="userSpaceOnUse"><stop stop-color="#fff4d2"/><stop offset=".4" stop-color="#dfc58a"/><stop offset="1" stop-color="#9b7b49"/></linearGradient></defs>
      <path d="M40 4L52 58L40 138L28 58Z" fill="url(#coreBlade)"/>
      <path d="M12 61Q40 76 68 61L62 75Q40 84 18 75Z" fill="#d5b779"/>
      <path d="M35 77H45V142H35Z" fill="#18354a" stroke="#d8bd82" stroke-width="1.5"/>
      <path d="M31 142H49L40 157Z" fill="#c7a76d"/><path d="M40 12V125" stroke="#fff8e8" stroke-opacity=".48" stroke-width="1"/>
    </svg>
  </div>
</div>
<script>
  // @ts-nocheck -- imperative DOM/Canvas runtime; content schemas and routes remain type-checked.
  const scene = document.querySelector('[data-orbital-field]');
  const canvas = scene?.querySelector('[data-orbital-canvas]');
  const ctx = canvas instanceof HTMLCanvasElement ? canvas.getContext('2d') : null;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (scene instanceof HTMLElement && canvas instanceof HTMLCanvasElement && ctx) {
    const pointer = { x: 0, y: 0, active: false, nx: 0, ny: 0 };
    let w = 0, h = 0, dpr = 1, time = 0, raf = 0, last = 0, visible = true;
    const palette = () => document.documentElement.dataset.theme === 'dark'
      ? { gold: '#e5c98c', blue: '#9ec4dd', faint: 'rgba(190,215,229,.17)' }
      : { gold: '#a98a51', blue: '#6b8ca3', faint: 'rgba(35,58,75,.14)' };
    function resize() {
      const box = scene.getBoundingClientRect(); w = box.width; h = box.height; dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.round(w * dpr)); canvas.height = Math.max(1, Math.round(h * dpr)); ctx.setTransform(dpr, 0, 0, dpr, 0, 0); draw(time);
    }
    function point(rx, ry, rot, a, cx, cy, influence = true) {
      const cr = Math.cos(rot), sr = Math.sin(rot), c = Math.cos(a), s = Math.sin(a);
      let x = cx + rx * c * cr - ry * s * sr, y = cy + rx * c * sr + ry * s * cr;
      if (influence && pointer.active) {
        const dx = x - pointer.x, dy = y - pointer.y, d = Math.hypot(dx, dy), f = Math.exp(-(d * d) / (190 * 190)), bend = f * 27;
        x += dx * f * .11 - dy / (d + 1) * bend; y += dy * f * .11 + dx / (d + 1) * bend;
      }
      return { x, y };
    }
    function track(rx, ry, rot, cx, cy, color, alpha, width, dashed = false) {
      ctx.beginPath(); const n = 220;
      for (let i = 0; i <= n; i++) { const p = point(rx, ry, rot, Math.PI * 2 * i / n, cx, cy); if (!i) ctx.moveTo(p.x, p.y); else ctx.lineTo(p.x, p.y); }
      ctx.closePath(); ctx.strokeStyle = color; ctx.globalAlpha = alpha; ctx.lineWidth = width; ctx.setLineDash(dashed ? [2, 9] : []); ctx.stroke(); ctx.setLineDash([]); ctx.globalAlpha = 1;
    }
    function comet(rx, ry, rot, angle, speed, cx, cy, color) {
      const direction = Math.sign(speed), steps = 22, head = point(rx, ry, rot, angle, cx, cy), tail = point(rx, ry, rot, angle - direction * .72, cx, cy);
      const gradient = ctx.createLinearGradient(tail.x, tail.y, head.x, head.y);
      gradient.addColorStop(0, 'rgba(0,0,0,0)'); gradient.addColorStop(.7, color); gradient.addColorStop(1, '#fff6df');
      ctx.beginPath();
      for (let i = 0; i <= steps; i++) { const p = point(rx, ry, rot, angle - direction * (.72 * i / steps), cx, cy); if (!i) ctx.moveTo(p.x, p.y); else ctx.lineTo(p.x, p.y); }
      ctx.strokeStyle = gradient; ctx.lineWidth = 2.2; ctx.lineCap = 'round'; ctx.stroke();
      const glow = ctx.createRadialGradient(head.x, head.y, 0, head.x, head.y, 17);
      glow.addColorStop(0, color); glow.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = glow; ctx.beginPath(); ctx.arc(head.x, head.y, 17, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = '#fff8e8'; ctx.beginPath(); ctx.arc(head.x, head.y, 2.2, 0, Math.PI * 2); ctx.fill();
    }
    function draw(t) {
      if (!w || !h) return; ctx.clearRect(0, 0, w, h);
      const p = palette(), m = Math.min(w, h), cx = w / 2 + pointer.nx * 18, cy = h / 2 + pointer.ny * 14;
      const halo = ctx.createRadialGradient(cx, cy, 0, cx, cy, m * .52);
      halo.addColorStop(0, 'rgba(153,185,204,.14)'); halo.addColorStop(1, 'rgba(0,0,0,0)'); ctx.fillStyle = halo; ctx.fillRect(0, 0, w, h);
      const a = { rx: m * .46, ry: m * .2, rot: -.48 + pointer.nx * .16, speed: .58 };
      const b = { rx: m * .37, ry: m * .3, rot: .9 - pointer.ny * .12, speed: -.43 };
      const c = { rx: m * .49, ry: m * .34, rot: .12 + pointer.ny * .13, speed: .31 };
      track(a.rx, a.ry, a.rot, cx, cy, p.gold, .8, 1.25); track(b.rx, b.ry, b.rot, cx, cy, p.blue, .72, 1.1); track(c.rx, c.ry, c.rot, cx, cy, p.faint, .9, .9, true);
      ctx.strokeStyle = p.faint; ctx.lineWidth = .8; ctx.setLineDash([2, 9]);
      ctx.beginPath(); ctx.moveTo(cx, cy - m * .46); ctx.lineTo(cx, cy + m * .46); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(cx - m * .46, cy); ctx.lineTo(cx + m * .46, cy); ctx.stroke(); ctx.setLineDash([]);
      comet(a.rx, a.ry, a.rot, t * a.speed + .4, a.speed, cx, cy, 'rgba(220,190,126,.8)');
      comet(a.rx, a.ry, a.rot, t * a.speed + 3.5, a.speed, cx, cy, 'rgba(220,190,126,.65)');
      comet(b.rx, b.ry, b.rot, t * b.speed + 1.5, b.speed, cx, cy, 'rgba(137,183,211,.8)');
      comet(c.rx, c.ry, c.rot, t * c.speed + 4.2, c.speed, cx, cy, 'rgba(220,190,126,.55)');
      if (pointer.active) {
        const g = ctx.createRadialGradient(pointer.x, pointer.y, 0, pointer.x, pointer.y, 150);
        g.addColorStop(0, 'rgba(214,190,137,.18)'); g.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = g; ctx.beginPath(); ctx.arc(pointer.x, pointer.y, 150, 0, Math.PI * 2); ctx.fill();
      }
    }
    function tick(stamp) {
      raf = 0; if (document.hidden || !visible || reduce.matches) return;
      const dt = last ? Math.min((stamp - last) / 1000, .04) : .016; last = stamp; time += dt;
      const tx = pointer.active ? pointer.x / Math.max(w, 1) - .5 : 0, ty = pointer.active ? pointer.y / Math.max(h, 1) - .5 : 0;
      pointer.nx += (tx - pointer.nx) * .06; pointer.ny += (ty - pointer.ny) * .06; draw(time); raf = requestAnimationFrame(tick);
    }
    function start() { if (!raf && visible && !document.hidden && !reduce.matches) raf = requestAnimationFrame(tick); }
    scene.addEventListener('pointermove', (event) => { const box = scene.getBoundingClientRect(); pointer.x = event.clientX - box.left; pointer.y = event.clientY - box.top; pointer.active = true; }, { passive: true });
    scene.addEventListener('pointerleave', () => { pointer.active = false; });
    const observer = new IntersectionObserver((entries) => { visible = entries[0].isIntersecting; if (visible) start(); else { cancelAnimationFrame(raf); raf = 0; } }, { threshold: .05 });
    observer.observe(scene); new ResizeObserver(resize).observe(scene);
    document.addEventListener('visibilitychange', () => { if (document.hidden) { cancelAnimationFrame(raf); raf = 0; } else start(); });
    reduce.addEventListener?.('change', () => { if (reduce.matches) { cancelAnimationFrame(raf); raf = 0; draw(time); } else start(); });
    resize(); if (reduce.matches) draw(0); else start();
  }
</script>
